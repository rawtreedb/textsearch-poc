# Hostname for Caddy (Let's Encrypt). Use :80 to serve plain HTTP on the IP until DNS exists.
DOMAIN=:80
RAWTREE_API_KEY=
# Optional read-only key for search queries
RAWTREE_QUERY_API_KEY=
RAWTREE_DATABASE=default
# Loaders keep downloaded source files and resume state here (a Docker volume)
DATA_DIR=/data
